{
  "name": "dev-flow",
  "displayName": "Dev Flow · 专家开发团队",
  "version": "2.0.0",
  "description": "以用户设计选择、边界所有权和依赖波次为核心的精简前端开发团队流程。",
  "author": "along-h",
  "license": "MIT",
  "keywords": [
    "frontend",
    "pipeline",
    "multi-agent",
    "orchestration",
    "expert-team",
    "tdd",
    "code-review"
  ],
  "entry": "SKILL.md",
  "type": "skill",
  "agents": [
    {
      "id": "requirements-analyst",
      "name": "需求分析师",
      "alias": "Lin（需求分析师）",
      "file": "agents/requirements-analyst.md",
      "role": "按需需求澄清负责人，用 grilling 补齐业务目标、范围、行为和验收",
      "persona": "从用户目标出发，查清事实，问透关键决策"
    },
    {
      "id": "task-decomposer",
      "name": "技术负责人",
      "alias": "Liu（技术负责人）",
      "file": "agents/task-decomposer.md",
      "role": "按需技术负责人，负责多工作包拆分、真实风险分级、架构路由和 Standard 风险增量审核",
      "persona": "先找可独立验收的交付边界，再排依赖"
    },
    {
      "id": "developer",
      "name": "前端开发工程师",
      "alias": "Zhang（前端开发工程师）",
      "file": "agents/developer.md",
      "role": "代码实现者，先写测试再写代码",
      "persona": "手速快，但先写测试再写代码，引用组件索引不重复实现"
    },
    {
      "id": "code-reviewer",
      "name": "独立质量审查官",
      "alias": "Wang（独立质量审查官）",
      "file": "agents/code-reviewer.md",
      "role": "条件质量审查官，仅在命中 reviewTriggers、用户明确要求或 Rigorous 路线时介入",
      "persona": "在明确时间预算内核验触发风险；超时返回进度并交由主 Agent 接管",
      "optional": true
    },
    {
      "id": "project-scanner",
      "name": "项目扫描师",
      "alias": "Scanner（项目扫描师）",
      "file": "agents/project-scanner.md",
      "role": "工程化专家，优先定向扫描受影响入口、惯例、测试和真实复用候选",
      "persona": "读代码的，用最小扫描范围给出可回查证据"
    },
    {
      "id": "architect",
      "name": "按需架构专家",
      "alias": "Chen（按需架构专家）",
      "file": "agents/architect.md",
      "role": "按需架构专家，负责共享架构和高风险技术方案",
      "persona": "只在共享边界和高风险决策需要独立判断时介入",
      "optional": true
    }
  ],
  "scripts": [
    {
      "id": "scan-project",
      "file": "scripts/scan-project.js",
      "description": "确定性扫描项目结构、组件、npm 包、Skill，输出 JSON"
    },
    {
      "id": "validate-artifact",
      "file": "scripts/validate-artifact.js",
      "description": "保留的旧版产物格式校验器，供历史运行兼容使用"
    }
  ],
  "templates": [
    "templates/plan-template.md",
    "templates/prd-template.md",
    "templates/design-sources-template.md",
    "templates/module-design-spec-template.md",
    "templates/component-index-template.md",
    "templates/handoff-template.md",
    "templates/component-slice-template.md",
    "templates/components-template.md",
    "templates/tdd-template.md",
    "templates/review-report-template.md",
    "templates/task-breakdown-template.md",
    "templates/global-architecture-template.md"
  ],
  "artifacts": {
    "project": ".dev-flow/project/",
    "runs": ".dev-flow/runs/",
    "legacyReadOnly": ".dev-flow/artifacts/"
  },
  "engines": {
    "node": ">=18"
  },
  "capabilities": {
    "designDecision": "user-choice-before-ui-development",
    "parallelism": "dependency-waves",
    "legacyArtifactValidation": true,
    "discoveryDepth": ["light", "standard", "deep"],
    "topology": ["single-workstream", "multi-workstream"],
    "governance": ["fast", "standard", "rigorous"],
    "defaultGovernance": "fast",
    "scheduling": "complexity-adaptive",
    "reviewScheduling": "conditional",
    "reuseScope": ["none", "local", "cross-work-package", "global"],
    "qualityGate": [
      "gate-confirmation",
      "targeted-test",
      "lint",
      "typecheck",
      "build",
      "conditional-review"
    ],
    "contextProtocol": "plan-first-risk-scoped",
    "reviewMode": ["conditional-triggered", "rigorous-required", "timeout-takeover"]
  }
}
