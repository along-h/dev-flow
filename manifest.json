{
  "name": "dev-flow",
  "displayName": "Dev Flow · 专家开发团队",
  "version": "1.1.0",
  "description": "多 Agent 开发流水线，通过项目索引复用、HANDOFF 最小上下文和增量复审，按工作包拓扑与风险深度自适应编排需求、架构、开发、审查和交付。",
  "author": "along-h",
  "license": "MIT",
  "keywords": [
    "frontend",
    "pipeline",
    "multi-agent",
    "orchestration",
    "expert-team",
    "tdd",
    "code-review"
  ],
  "entry": "SKILL.md",
  "type": "skill",
  "agents": [
    {
      "id": "requirements-analyst",
      "name": "需求分析师",
      "alias": "Lin（需求分析师）",
      "file": "agents/requirements-analyst.md",
      "role": "按需需求澄清负责人，只在需求不清晰时用内置 grilling 补齐需求基线并提取设计 Token",
      "persona": "从用户目标出发，查清事实，问透关键决策"
    },
    {
      "id": "task-decomposer",
      "name": "技术负责人",
      "alias": "Liu（技术负责人）",
      "file": "agents/task-decomposer.md",
      "role": "技术拆分与架构门禁负责人，负责工作包、依赖、风险分级、架构路由和 Standard 方案审核",
      "persona": "先找可独立验收的交付边界，再排依赖"
    },
    {
      "id": "developer",
      "name": "前端开发工程师",
      "alias": "Zhang（前端开发工程师）",
      "file": "agents/developer.md",
      "role": "代码实现者，先写测试再写代码",
      "persona": "手速快，但先写测试再写代码，引用组件索引不重复实现"
    },
    {
      "id": "code-reviewer",
      "name": "独立质量审查官",
      "alias": "Wang（独立质量审查官）",
      "file": "agents/code-reviewer.md",
      "role": "质量守门员，基于证据完整报告 P0/P1/P2 并执行限定复审",
      "persona": "先核验证据与影响，再报告所有级别问题，由用户决定是否修改"
    },
    {
      "id": "project-scanner",
      "name": "项目扫描师",
      "alias": "Scanner（项目扫描师）",
      "file": "agents/project-scanner.md",
      "role": "工程化专家，项目全景扫描 + 组件索引",
      "persona": "读代码的，快速摸清架构与可复用资源"
    },
    {
      "id": "architect",
      "name": "按需架构专家",
      "alias": "Chen（按需架构专家）",
      "file": "agents/architect.md",
      "role": "按需架构专家，负责共享架构和高风险技术方案",
      "persona": "只在共享边界和高风险决策需要独立判断时介入",
      "optional": true
    }
  ],
  "scripts": [
    {
      "id": "scan-project",
      "file": "scripts/scan-project.js",
      "description": "确定性扫描项目结构、组件、npm 包、Skill，输出 JSON"
    },
    {
      "id": "validate-artifact",
      "file": "scripts/validate-artifact.js",
      "description": "校验产物格式（含 components-readiness 与用户选中修改的限定复审契约）"
    }
  ],
  "templates": [
    "templates/prd-template.md",
    "templates/design-sources-template.md",
    "templates/module-design-spec-template.md",
    "templates/component-index-template.md",
    "templates/handoff-template.md",
    "templates/component-slice-template.md",
    "templates/components-template.md",
    "templates/tdd-template.md",
    "templates/review-report-template.md",
    "templates/task-breakdown-template.md",
    "templates/global-architecture-template.md"
  ],
  "artifacts": {
    "project": ".dev-flow/project/",
    "runs": ".dev-flow/runs/",
    "legacyReadOnly": ".dev-flow/artifacts/"
  },
  "engines": {
    "node": ">=18"
  },
  "capabilities": {
    "discoveryDepth": ["light", "standard", "deep"],
    "topology": ["single-workstream", "multi-workstream"],
    "governance": ["fast", "standard", "rigorous"],
    "scheduling": "complexity-adaptive",
    "qualityGate": [
      "validate-artifact",
      "component-design-readiness",
      "gate-confirmation",
      "user-selected-review-loop"
    ],
    "contextProtocol": "handoff-sliced",
    "reviewMode": ["full-first-round", "selected-change-recheck"]
  }
}
